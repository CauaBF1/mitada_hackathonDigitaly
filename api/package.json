{
  "name": "nexo-business-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "test:whatsapp": "npm run build && node scripts/whatsapp-smoke.mjs",
    "test:price-history": "npm run build && node scripts/price-history-smoke.mjs",
    "test:purchase-recommendation": "npm run build && node scripts/purchase-recommendation.mjs && node scripts/purchase-recommendation-smoke.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "better-sqlite3": "^11.8.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}
