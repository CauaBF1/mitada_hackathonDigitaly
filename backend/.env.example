DATABASE_URL=sqlite:///./procurement.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1,::1,backend
MUTATIONS_PER_MINUTE=30
VOICE_WEBHOOK_SECRET=
SEED_DEMO_DATA=false
MOCK_VOICE_DELAY_SECONDS=6
LANGSMITH_TRACING=false
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
SEARCH_CREDENTIALS_PATH=.local/search_credentials.json
SCRAPE_TIMEOUT_SECONDS=12
DISCOVERY_TIMEOUT_SECONDS=100

LLM_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
AGENT_CHECKPOINT_PATH=.local/agent-checkpoints.sqlite
MAX_NEGOTIATION_ROUNDS=3

MY_TELEGRAM_CHAT_ID=

# WhatsApp / Evolution v2 (NestJS, porta 4000)
WHATSAPP_API_URL=http://localhost:8080
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE_NAME=nexo
WHATSAPP_WEBHOOK_SECRET=
EVOLUTION_DB_PASSWORD=evolution-local

# Vapi — agente de voz duplex (https://vapi.ai)
# Obtenha em https://dashboard.vapi.ai/api-keys
VAPI_API_KEY=
# ID do assistente criado no painel Vapi (voice_agent_config.json)
VAPI_ASSISTANT_ID=
# ID do número de telefone comprado/verificado no Vapi
VAPI_PHONE_NUMBER_ID=
# URL pública HTTPS que o Vapi deve chamar para tool-calls e end-of-call-report
# Exemplo: https://seu-tunnel.trycloudflare.com/webhook/voice
VAPI_WEBHOOK_URL=
