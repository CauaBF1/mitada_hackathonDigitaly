# Copie para .env na raiz; use segredos distintos e não vazios.
INTERNAL_API_TOKEN=
AGENT_URL=http://localhost:8000

# Integração Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_WEBHOOK_URL=

# LLMs & Agentes
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Chave Tavily opcional para pesquisa de mercado e busca de reputação RA
TAVILY_API_KEY=tvly-your-key-here

# WhatsApp / Evolution v2 (NestJS, porta 4000)
WHATSAPP_API_URL=http://localhost:8080
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE_NAME=nexo
WHATSAPP_WEBHOOK_SECRET=
VOICE_WEBHOOK_SECRET=
EVOLUTION_DB_PASSWORD=evolution-local

# Vapi — agente de voz duplex (WebRTC Full-Duplex em /call/[id])
PUBLIC_APP_URL=http://localhost:3000
VAPI_API_KEY=
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_URL=

# Autenticação & Google OAuth2 (Fallback local ativo se vazio)
JWT_SECRET=nexo-dev-jwt-secret-change-in-production
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
