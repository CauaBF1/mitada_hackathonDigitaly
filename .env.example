# Copie para .env na raiz; use segredos distintos e não vazios.
INTERNAL_API_TOKEN=
AGENT_URL=http://localhost:8000

# Jev purchase recommendation (server only; optional until this feature is used)
TYPESAFE_API_KEY=
JEV_API_KEY=
TYPESAFE_MODEL=jev-1.14.0
SUPPLIER_MAX_PREMIUM_PERCENT=5

# Integração Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_WEBHOOK_URL=

# LLMs & Agentes
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Chave Tavily opcional para pesquisa de mercado e busca de reputação RA
TAVILY_API_KEY=tvly-your-key-here

# WhatsApp / Evolution v2 (NestJS, porta 4000)
WHATSAPP_API_URL=http://127.0.0.1:8080
# Relay local opcional para webhooks de uma Evolution em Docker, sem expor a API Nest.
WHATSAPP_GATEWAY_HOST=
WHATSAPP_GATEWAY_PORT=8082
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE_NAME=nexo
# Contato padrão opcional, configurado explicitamente por número internacional (DDI + número).
WHATSAPP_SUPPLIER_NUMBER=
# Contato de teste opcional, também explícito e restrito às novas solicitações.
WHATSAPP_TEST_SUPPLIER_NUMBER=
WHATSAPP_TELEGRAM_FALLBACK_SECONDS=60
WHATSAPP_WEBHOOK_SECRET=
VOICE_WEBHOOK_SECRET=
EVOLUTION_DB_PASSWORD=evolution-local

# Vapi — agente de voz duplex (WebRTC Full-Duplex em /call/[id])
PUBLIC_APP_URL=http://localhost:3000
VAPI_API_KEY=
# Public key from Vapi dashboard (never use the private API key in the browser).
VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_URL=

# Autenticação & Google OAuth2 (Fallback local ativo se vazio)
JWT_SECRET=nexo-dev-jwt-secret-change-in-production
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Limites de interpretação e extração Tavily (não habilitam cobrança).
LLM_TIMEOUT_SECONDS=20
TAVILY_EXTRACT_TIMEOUT_SECONDS=45
TAVILY_EXTRACT_MAX_URLS_PER_TASK=10
TAVILY_EXTRACT_MAX_CREDITS_PER_TASK=10
TAVILY_EXTRACT_MAX_RETRIES=2
TAVILY_EXTRACT_CONCURRENCY=2
REPUTATION_REFRESH_TOTAL_BUDGET_SECONDS=30
REPUTATION_REFRESH_MAX_DOMAINS=10
REPUTATION_REFRESH_DOMAIN_TIMEOUT_SECONDS=20
REPUTATION_REFRESH_SEARCH_TIMEOUT_SECONDS=8
REPUTATION_REFRESH_CONCURRENCY=10
GATEWAY_TIMEOUT_SECONDS=45

# Contact priority: WebRTC invitation, WhatsApp text, then Telegram.
VOICE_ANSWER_TIMEOUT_SECONDS=120
ALLOW_EXTERNAL_ACCESS=true
WHATSAPP_AUTO_CONFIGURE_WEBHOOK=true
